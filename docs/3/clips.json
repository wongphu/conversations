[
  {
    "file": "3/audio/en/00-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "Excuse me, can you help me?"
  },
  {
    "file": "3/audio/es/00-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "Disculpe, ¿me puede ayudar?"
  },
  {
    "file": "3/audio/en/01-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "Sure! What do you need?"
  },
  {
    "file": "3/audio/es/01-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "¡Claro! ¿Qué necesita?"
  },
  {
    "file": "3/audio/en/02-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "I’m looking for the library."
  },
  {
    "file": "3/audio/es/02-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "Estoy buscando la biblioteca."
  },
  {
    "file": "3/audio/en/03-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "The library is on Via Volcan in Nueva California. It is across the street from Super Berad in the San Benito Compound."
  },
  {
    "file": "3/audio/es/03-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "La biblioteca está en Vía Volcán en Nueva California. Está al otro lado de la calle de Super Berad en el complejo San Benito."
  },
  {
    "file": "3/audio/en/04-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "How do I get there from Romero?"
  },
  {
    "file": "3/audio/es/04-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "¿Cómo llego desde Romero?"
  },
  {
    "file": "3/audio/en/05-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "Go straight on this street."
  },
  {
    "file": "3/audio/es/05-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "Siga derecho por esta calle."
  },
  {
    "file": "3/audio/en/06-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "For how many blocks?"
  },
  {
    "file": "3/audio/es/06-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "¿Por cuántas cuadras?"
  },
  {
    "file": "3/audio/en/07-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "About six blocks. It is on the left side of the road."
  },
  {
    "file": "3/audio/es/07-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "Unas seis cuadras. Está en el lado izquierdo de la carretera."
  },
  {
    "file": "3/audio/en/08-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "Which building is the library?"
  },
  {
    "file": "3/audio/es/08-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "¿En qué edificio se encuentra la biblioteca?"
  },
  {
    "file": "3/audio/en/09-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "It is the first building on the left."
  },
  {
    "file": "3/audio/es/09-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "Es el primer edificio a la izquierda."
  },
  {
    "file": "3/audio/en/10-a.mp3",
    "speaker": "en_a",
    "lang": "en",
    "text": "Thank you very much!"
  },
  {
    "file": "3/audio/es/10-a.mp3",
    "speaker": "es_a",
    "lang": "es",
    "text": "¡Muchas gracias!"
  },
  {
    "file": "3/audio/en/11-b.mp3",
    "speaker": "en_b",
    "lang": "en",
    "text": "You’re welcome. Good luck!"
  },
  {
    "file": "3/audio/es/11-b.mp3",
    "speaker": "es_b",
    "lang": "es",
    "text": "De nada. ¡Buena suerte!"
  }
]
